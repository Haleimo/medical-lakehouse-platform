# Copy this file to .env for local development:
#   cp .env.example .env
# Never commit the real .env file (it is in .gitignore).
#
# In Kubernetes, these same variable names are populated from a ConfigMap
# (non-sensitive values) and a Secret (S3 keys, DEID_SALT) instead of a
# .env file -- see k8s/configmap.yaml and k8s/secret.example.yaml.

# --- Run mode ---
# "local"   -> pipeline reads/writes the local `data/` directory, no S3/Spark
#              cluster required. This is the default and what the sample
#              ingestion + tests use.
# "cluster" -> pipeline talks to real Garage S3 + the Nessie/Iceberg catalog.
RUN_MODE=local
LOCAL_DATA_ROOT=./data
LOG_LEVEL=INFO

# --- Object storage (Garage / any S3-compatible endpoint) ---
# Leave these blank for RUN_MODE=local. Required for RUN_MODE=cluster.
S3_ENDPOINT=http://localhost:3900
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=garage
BUCKET_RAW=medical-raw
BUCKET_BRONZE=medical-bronze
BUCKET_QUARANTINE=medical-quarantine
WAREHOUSE_PATH=s3a://nessie-warehouse/

# --- Project Nessie / Iceberg catalog ---
NESSIE_URI=http://localhost:19120/api/v2
NESSIE_DEFAULT_BRANCH=main
ICEBERG_CATALOG_NAME=iceberg

# --- De-identification ---
# CHANGE THIS in any real deployment and manage it as a Kubernetes Secret,
# not a committed value. Rotating this salt changes every mrn_hash value, so
# treat it like a signing key.
DEID_SALT=local-dev-salt-change-me

# --- Data quality gate ---
# Fraction of records in a batch allowed to fail validation before the
# pipeline run is failed outright (see src/quality/checks.py).
MAX_INVALID_RATIO=0.2

# --- Airflow DAG configuration ---
MEDICAL_PIPELINE_SCHEDULE=@daily
FHIR_SOURCE_DIR=./data/sample/fhir

# --- Garage admin (used only by scripts/setup-garage-keys.sh and the Helm
# chart's Kubernetes Secret -- see charts/garage/templates/secret.yaml) ---
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
