# Environment / secrets
# ---------------------------------------------------------------------------
.env
.env.local
*.local.yaml
k8s/secret.local.yaml

# ---------------------------------------------------------------------------
# Data layers
#
# Everything under data/ is generated by the pipeline at runtime and must
# NOT be committed -- EXCEPT the checked-in sample fixtures under
# data/sample/, which the test suite reads.
#
# Note: `data/*` (not `data/`) is required so the negation rules below can
# re-include files inside the directory. An excluded directory cannot be
# descended into, so `data/` + `!data/sample/` would silently not work.
# ---------------------------------------------------------------------------
data/*
!data/sample/
!data/sample/**

# ---------------------------------------------------------------------------
# Spark / JVM
# ---------------------------------------------------------------------------
*.log
spark-warehouse/
metastore_db/
derby.log

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db